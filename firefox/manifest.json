{
   "name": "Minimal X / Twitter",
   "short_name": "Minimal X",
   "version": "1.4.0",
   "description": "A clean, focused interface for X (formerly Twitter) with a professional layout.",
   "manifest_version": 3,
   "browser_specific_settings": {
      "gecko": {
         "id": "minimalx@austinemaina.com",
         "strict_min_version": "120.0"
      }
   },
   "icons": {
      "128": "icons/128.png"
   },
   "action": {
      "default_popup": "popup.html"
   },
   "permissions": [
      "scripting",
      "activeTab",
      "storage"
   ],
   "host_permissions": [
      "*://*.twitter.com/*",
      "*://*.x.com/*"
   ],
   "background": {
      "scripts": [
         "background.js"
      ]
   },
   "content_scripts": [
      {
         "run_at": "document_start",
         "matches": [
            "*://*.twitter.com/*",
            "*://*.x.com/*"
         ],
         "js": [
            "override.js"
         ],
         "world": "MAIN"
      },
      {
         "run_at": "document_start",
         "matches": [
            "*://*.twitter.com/*",
            "*://*.x.com/*"
         ],
         "css": [
            "override.css"
         ]
      }
   ]
}